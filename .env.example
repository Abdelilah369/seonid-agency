# Copy to .env.local and fill in real values. Never commit .env.local.

# Used for generating hero/section imagery per build-brief.md step 5.
# Not yet wired into any code path in this build.
OPENAI_API_KEY=

# Required for app/api/audit/route.ts to actually email audit requests
# to hello@seonid.agency. Without this set, submissions are still
# accepted (form works, no error shown to the visitor) but only get
# logged server-side, not emailed anywhere.
#
# Get a free key at https://resend.com — you'll also need to verify
# the seonid.agency sending domain there before NOTIFY_FROM will work
# (until verified, Resend only lets you send to your own account email).
RESEND_API_KEY=
