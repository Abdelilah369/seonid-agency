# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# agents
.agents/

# local automation scripts (WhatsApp lead outreach — contains sensitive session data)
/scripts/

# Original large videos — keep source local, deploy web-optimized only
/public/videos/*.mp4
!/public/videos/*_web.mp4
/public/promo/*.mp4
!/public/promo/*_web.mp4

# Original hero images — deploy web-optimized only
/public/images/hero-*.jpg
!/public/images/*_web.jpg
